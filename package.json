{
  "name": "labscribber",
  "private": true,
  "version": "1.2.0",
  "description": "A browser-based scientific spectroscopy workstation for UV-Vis, FTIR, Raman, NMR, XPS, photoluminescence, XRD, and electrochemical (CV/EIS) data analysis, backed by an automated test suite (177 tests).",
  "license": "MIT",
  "author": "Asif Raza",
  "contributors": [
    "Huma Basheer"
  ],
  "type": "module",
  "main": "main.cjs",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-desktop server.js",
    "lint": "tsc --noEmit",
    "electron:dev": "vite --port=3000 --host=0.0.0.0 & ELECTRON_DEV_URL=http://localhost:3000 electron .",
    "electron:build": "npm run build && electron-builder build --dir",
    "electron:dist": "npm run build && electron-builder --win --mac --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.21",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "svg2pdf.js": "^2.7.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^8.3.5",
    "vitest": "^2.1.8",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.labscribber.app",
    "productName": "Labscribber",
    "copyright": "Copyright (c) 2026 Asif Raza",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs",
      "package.json",
      "build/**/*",
      "splash.html"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "identity": null
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Science",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asifverse4/LabScribber.git"
  },
  "homepage": "https://github.com/asifverse4/LabScribber#readme",
  "bugs": {
    "url": "https://github.com/asifverse4/LabScribber/issues"
  }
}
